type BallotView = record {
  at : nat64;
  seq : nat64;
  // 128-hex Ed25519 signature over `hashing::ballot_sig_message`. In the
  // log so the franchise check is recomputable from published data alone,
  // rather than resting on this canister's word about who called `cast`.
  sig : text;
  // The expiry the voter signed into the ballot (ns since epoch).
  // Published so a verifier can reconstruct the signed message and check
  // the invariant `at <= sig_expires_at` -- the canister enforcing the
  // expiry is only auditable if the expiry itself is on the board.
  sig_expires_at : nat64;
  // Derived from `voter_pubkey` (sha224(DER) || 0x02), published for
  // readability. A verifier re-derives it; a `voter` that does not match
  // the key is a forged board.
  voter : principal;
  // 64-hex chain head after this entry -- the voter's receipt.
  entry_hash : text;
  choice : nat32;
  // 88-hex DER-encoded Ed25519 public key: the ballot's credential.
  voter_pubkey : text;
};
// A log head plus everything needed to tie it to the canister's certified
// data without trusting the reply.
type CertifiedHead = record {
  ballot_count : nat64;
  // The IC state certificate, whose `certified_data` is that root.
  // 
  // `None` outside a query call (`data_certificate` is unavailable in
  // updates). A client that receives `None` must treat the head as
  // UNVERIFIED, never as verified-by-absence.
  certificate : opt blob;
  // 64-hex.
  log_head : text;
  election_id : nat64;
  // Sibling path from this election's leaf to the Merkle root.
  witness : vec WitnessStep;
  // 64-hex. Zero hash while the election is a draft.
  manifest_hash : text;
};
// Summary. Excludes the roll and the log, which have their own paginated
// endpoints because either can be large.
type ElectionView = record {
  id : nat64;
  pin : opt Pin;
  ballot_count : nat64;
  title : text;
  admin : principal;
  closed_at : opt nat64;
  question : text;
  opened_at : opt nat64;
  // 64-hex head of the ballot log.
  log_head : text;
  created_at : nat64;
  roll_size : nat64;
  // 64-hex. `None` until the election opens and the manifest freezes.
  manifest_hash : opt text;
  phase : Phase;
  options : vec text;
};
// Exactly the fields that go into `manifest_hash`, so a client can recompute
// it rather than believe the canister's copy.
type Manifest = record {
  id : nat64;
  pin : Pin;
  title : text;
  admin : principal;
  question : text;
  opened_at : nat64;
  // 64-hex over the sorted roll.
  roll_hash : text;
  // 64-hex. Advisory: recompute it, do not trust it.
  manifest_hash : text;
  options : vec text;
};
type NewElection = record { title : text; question : text; options : vec text };
type Phase = variant {
  // Voting window. Manifest is frozen; ballots are accepted.
  Open;
  // Window closed. Log and tally are final.
  Closed;
  // Being set up. Roll and pin are mutable; nothing is committed.
  Draft;
};
// The release a voter's client must be running for this election.
// 
// This is the load-bearing anti-malicious-client record (THREAT_MODEL.md
// 2.1 and 2.5). It lives inside the manifest hash, so an administrator
// cannot repoint an open election at a different frontend build without
// invalidating every ballot's chain position -- pinning the expected module
// hash "for the duration of the voting window" is a state invariant here,
// not a deployment convention.
type Pin = record {
  // ic-git repo name. The registry record actually read is
  // `<repo>#site` (ic-git docs/ATTESTATION.md, "The two record types").
  repo : text;
  // 64-hex sha256 of the served bundle entrypoint.
  bundle_sha256 : text;
  // Principal of the ic-git canister serving that bundle.
  site_canister : text;
  // 64-hex module hash the *poll* canister -- this one, the one holding the
  // roll, the log and the tally -- is expected to be running for the whole
  // window.
  // 
  // Separate from `module_sha256` because they are different canisters with
  // different controllers and different powers. `module_sha256` covers the
  // party who can change the ballot *page*; this covers the party who can
  // change the code that *counts*. An earlier version of this design had
  // only the first and documented it as covering both, which meant a poll
  // canister could be upgraded mid-election to code that mis-tallies or
  // rewrites the log with no change to any verdict a voter sees.
  // 
  // What this is: a value the administrator declares before the window
  // opens, frozen into the manifest hash, that a client compares against a
  // certified read. What it is not: proof the declared value was ever the
  // right one. It makes a mid-window *change* visible, which is the attack
  // in THREAT_MODEL.md 2.5; it does not establish the starting point. That
  // is what the K-of-N attestation on the module hash is for.
  poll_module_sha256 : text;
  // Registry contract address on that chain.
  registry_address : text;
  // 64-hex module hash the *site* canister is expected to be running for
  // the whole window. A certified read that differs is a spoiling event.
  module_sha256 : text;
  // 40-hex git commit the bundle was published from.
  commit : text;
  // EVM chain holding the ProvenanceRegistry for this election.
  registry_chain_id : nat64;
};
type Receipt = record {
  at : nat64;
  seq : nat64;
  voter : principal;
  entry_hash : text;
  log_head : text;
  election_id : nat64;
  choice : nat32;
};
type Result = variant { Ok : Receipt; Err : VoteError };
type Result_1 = variant { Ok : CertifiedHead; Err : VoteError };
type Result_2 = variant { Ok : ElectionView; Err : VoteError };
type Result_3 = variant { Ok : nat64; Err : VoteError };
type Result_4 = variant { Ok : vec BallotView; Err : VoteError };
type Result_5 = variant { Ok : Manifest; Err : VoteError };
type Result_6 = variant { Ok : vec principal; Err : VoteError };
type Result_7 = variant { Ok : Tally; Err : VoteError };
type Result_8 = variant { Ok; Err : VoteError };
type Tally = record {
  ballot_count : nat64;
  // 64-hex over (manifest, log head, counts). The value to checkpoint.
  // `None` before the manifest freezes.
  tally_hash : opt text;
  log_head : text;
  election_id : nat64;
  roll_size : nat64;
  // 64-hex. `None` before the manifest freezes.
  manifest_hash : opt text;
  phase : Phase;
  counts : vec nat64;
  options : vec text;
};
type VoteError = variant {
  AlreadyVoted;
  InvalidChoice;
  InvalidInput : text;
  NoPin;
  InvalidSignature;
  NotFound;
  WrongPhase : record { actual : text; expected : text };
  NotAdmin;
  // The ballot's signed expiry is in the past. Distinct from
  // `InvalidSignature` so a voter whose ballot sat too long gets "sign a
  // fresh one", not "your key is wrong".
  SignatureExpired;
  EmptyRoll;
  NotEligible;
  AnonymousCaller;
};
type WitnessStep = record {
  // 64-hex.
  sibling : text;
  sibling_is_right : bool;
};
service : () -> {
  // Cast one ballot, credentialed by an in-ballot signature rather than by the
  // message envelope.
  // 
  // An earlier version read `msg_caller` here and documented it as "the IC has
  // already authenticated the envelope". True, and exactly the problem: it
  // bound every ballot to the transport identity, which V1's encrypted ballots
  // would have republished as voter-to-choice at close (THREAT_MODEL.md 2.7).
  // Now the envelope caller is never read -- any caller, including the
  // anonymous principal, may deliver a ballot -- and eligibility is decided by
  // `credential::principal_of(voter_pubkey)` against the roll plus a signature
  // over `hashing::ballot_sig_message(self, manifest, choice)`. The credential
  // and signature are published in the log, so the franchise check no longer
  // rests on believing this canister recorded callers honestly.
  // `sig_expires_at` (ns since epoch) is signed into the ballot message and
  // bounds how long the signature authorizes anything: past it the cast is
  // refused, and it may not lie more than `state::MAX_SIG_TTL_NS` ahead of
  // subnet time. This is the freshness bound the ingress envelope used to
  // provide, relocated into the ballot itself.
  cast : (nat64, nat32, blob, blob, nat64) -> (Result);
  // The log head, its Merkle witness, and the IC state certificate.
  // 
  // This is the one read that does not require trusting the replying replica:
  // verify the certificate against the NNS root key, extract `certified_data`,
  // and check that recomputing the witness from this election's leaf yields it.
  // 
  // `certificate` is `None` when called as an update -- `data_certificate` is
  // only populated in query context. A client that gets `None` has an
  // unverified head and must say so; treating it as verified is the false-GREEN
  // failure ic-git's attestation doctrine forbids.
  certified_head : (nat64) -> (Result_1) query;
  close_election : (nat64) -> (Result_2);
  create_election : (NewElection) -> (Result_3);
  get_election : (nat64) -> (Result_2) query;
  get_log : (nat64, nat64, nat64) -> (Result_4) query;
  // The exact preimage of `manifest_hash`. Returned so a client can recompute
  // the hash instead of accepting the canister's word for it.
  get_manifest : (nat64) -> (Result_5) query;
  get_roll : (nat64, nat64, nat64) -> (Result_6) query;
  // Convenience only. The tally that matters is the one a verifier recomputes
  // from `get_log` (see `tools/verify-election.mjs`); this endpoint exists so a
  // UI can render a number, and a client that displays it without recomputing
  // it is trusting exactly the party E2E-V exists to distrust.
  get_tally : (nat64) -> (Result_7) query;
  list_elections : () -> (vec ElectionView) query;
  open_election : (nat64) -> (Result_2);
  // Pin the frontend release voters must be running. Draft only.
  pin_release : (nat64, Pin) -> (Result_8);
  // Replace the eligibility roll. Draft only. Returns the deduplicated size.
  // 
  // This is the T4 trust boundary in THREAT_MODEL.md: whoever calls this
  // decides who is a voter, and no cryptography here constrains that choice.
  // The roll is published (`get_roll`) and committed to by the manifest hash
  // precisely so the organization's members can audit the list they were
  // enrolled in.
  set_roll : (nat64, vec principal) -> (Result_3);
  whoami : () -> (principal) query;
}